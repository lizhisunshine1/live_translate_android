<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标背景：深蓝 → 青紫 对角渐变，与 ic_launcher_foreground 里的白色气泡箭头配套。
  覆盖 108x108 全幅，launcher 会按 squircle mask 裁切。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="#1B2B6B" />
                <item android:offset="0.5" android:color="#2F3E9E" />
                <item android:offset="1.0" android:color="#6A48D7" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 左上柔光，让底色不死板 -->
    <path android:pathData="M0,0 L108,0 L108,54 L0,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="54">
                <item android:offset="0.0" android:color="#33FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
